PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
JWT_EXPIRES_IN=7d
# Database Connection
# Option 1: Direct Neon or Hosted PostgreSQL connection string (Recommended)
DATABASE_URL=postgresql://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual variables (for local development)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=replace-with-your-db-password
DB_NAME=real_estate_db
DB_SSL=true

CORS_ORIGINS=https://real-estate-pro-pied.vercel.app,http://localhost:5173,http://127.0.0.1:5173
SERVE_FRONTEND=false

# Required only when running npm run db:seed
SEED_ADMIN_NAME=System Administrator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password
